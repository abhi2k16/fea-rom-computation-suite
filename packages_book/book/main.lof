\contentsline {figure}{\numberline {5.1}{\ignorespaces Force norm of a rigidly rotated unit-square element (a stress-free motion): linear kinematics against the total-Lagrangian element. Produced by \texttt {scripts/ch05\_assets.py}.\relax }}{14}{figure.caption.24}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Stress--strain loop of \code {TrussPlastic2D} ($E=200$ GPa, $\sigma _y=250$ MPa, $H=5$ GPa): the element against the closed-form return map. Produced by \texttt {scripts/ch05\_assets.py}.\relax }}{16}{figure.caption.27}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces The von Mises truss: closed form \textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:nl-vm}\unskip \@@italiccorr )}}, displacement control and arc length. Load control cannot pass the limit load. Produced by \texttt {scripts/ch05\_assets.py}; the problem is the one of \texttt {fea\_engine/examples/arc\_length\_snap\_through\_demo.py}.\relax }}{18}{figure.caption.32}%
\gdef \the@ipfilectr {}
