\contentsline {figure}{\numberline {6.1}{\ignorespaces Internal-force assembly of a \code {Quad4PlaneStressTL} plate: time of the loop and the batched route (left) and their ratio (right). Produced by \texttt {scripts/ch06\_assets.py}.\relax }}{24}{figure.caption.46}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Wall time of the same load-controlled Newton solve with the default path and with batched assembly and a sparse tangent.\relax }}{24}{figure.caption.48}%
