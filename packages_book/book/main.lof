\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces The model problem on a $40\times 40$ mesh ($1521\xspace $ unknowns). Left: displacement with the contact set outlined; right: contact force $\bm {\lambda }$, which is zero outside the contact set. The solver finds $295\xspace $ active constraints in $12\xspace $ iterations. Produced by \texttt {scripts/ch07\_assets.py}.\relax }}{28}{figure.caption.53}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Penalty against exact contact on the model problem ($841\xspace $ unknowns). Left: the largest penetration falls like $1/k_p$ but never reaches zero; the exact solution has no penetration (drawn at the plotting floor). Right: the condition number of the penalty matrix grows in proportion to $k_p$; the exact route solves a system whose condition number does not depend on any parameter.\relax }}{29}{figure.caption.54}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces The active-set iteration on the model problem with $N=1521\xspace $ unknowns. Left: the number of active constraints per iteration for the \texttt {reduced} and \texttt {saddle} routes (the curves coincide). Right: the number of constraints that changed status; the last point (plotted at 0.5) is zero changes, which is the stopping test.\relax }}{30}{figure.caption.59}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Wall time of the three routes against the number of unknowns (data of \Cref {tab:ct-scaling}).\relax }}{34}{figure.caption.71}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Error against time step for the two schemes (data of \Cref {tab:ct-order}).\relax }}{35}{figure.caption.78}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Bar impact, $\Delta t=0.002$. Left: wall force over the first $0.4$ time units. Right: energy relative to the initial energy over the whole run.\relax }}{36}{figure.caption.81}%
