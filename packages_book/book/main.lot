\contentsline {table}{\numberline {6.1}{\ignorespaces Estimated working memory of a batched tangent call (the dominant arrays, not the peak resident memory), from the package's own estimate.\relax }}{22}{table.caption.42}%
\contentsline {table}{\numberline {6.2}{\ignorespaces Loop against batched route: speed-up of the element kernels (force, tangent) and of the assembled force of the whole system, and the largest relative difference of the results. One run per family on the sandbox used for the figures of this chapter (2 CPUs).\relax }}{23}{table.caption.44}%
\contentsline {table}{\numberline {6.3}{\ignorespaces Where the concepts of this chapter live in the repository (release v1.0.1\,/\,v0.2.0).\relax }}{25}{table.caption.49}%
