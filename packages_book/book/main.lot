\contentsline {table}{\numberline {7.1}{\ignorespaces The three routes of the sparse contact solver and the failure reasons each can report.\relax }}{31}{table.caption.62}%
\contentsline {table}{\numberline {7.2}{\ignorespaces Where the concepts of this chapter live in the repository (release v1.0.1\,/\,v0.2.0).\relax }}{32}{table.caption.65}%
\contentsline {table}{\numberline {7.3}{\ignorespaces Six obstacles on the membrane model ($484\xspace $ unknowns). ``active'' is the number of active constraints; ``it.'' the iterations of each sparse route; the last four columns are the largest difference in $\bm {u}$ and $\bm {\lambda }$ to the dense active-set solution.\relax }}{33}{table.caption.68}%
\contentsline {table}{\numberline {7.4}{\ignorespaces The model problem on refined meshes. The dense route was not run above 3,500 unknowns. Single runs on the sandbox used for the figures of this chapter (2 CPUs).\relax }}{33}{table.caption.70}%
\contentsline {table}{\numberline {7.5}{\ignorespaces Error at $t=2$ of a free membrane against the exact modal solution; contact inactive. ``ratio'' is the error of the two-step scheme divided by that of BDF2.\relax }}{35}{table.caption.77}%
\contentsline {table}{\numberline {7.6}{\ignorespaces Bar impact on a rigid wall: energy relative to the initial energy, and the largest penetration, for the two schemes.\relax }}{36}{table.caption.80}%
\contentsline {table}{\numberline {7.7}{\ignorespaces Largest wall force of the bar impact, and energy kept by a bar without obstacle (broadband initial velocity, $t=1.5$), for both schemes.\relax }}{37}{table.caption.83}%
