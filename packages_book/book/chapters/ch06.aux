\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces How the PyTorch backend is patched in. A call with \texttt  {backend="torch"} leaves the default NumPy and SciPy route untouched and takes a separate path of three stages: conversion to tensors on the chosen device, computation in double precision, and conversion back to NumPy. Assembly and the Newton drivers do not change, and what the route cannot do is refused.\relax }}{51}{figure.caption.97}\protected@file@percent }
\newlabel{fig:bk-torch}{{6.4}{51}{How the PyTorch backend is patched in. A call with \texttt {backend="torch"} leaves the default NumPy and SciPy route untouched and takes a separate path of three stages: conversion to tensors on the chosen device, computation in double precision, and conversion back to NumPy. Assembly and the Newton drivers do not change, and what the route cannot do is refused.\relax }{figure.caption.97}{}}
\newlabel{fig:bk-torch@cref}{{[figure][4][6]6.4}{[1][51][]51}}
