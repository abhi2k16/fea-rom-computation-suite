\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces The mechanism of shear locking in a bilinear element under bending (schematic). The exact bending mode curves the edges and has no shear strain; the bilinear interpolation keeps the edges straight, which produces a parasitic shear strain and an artificially stiff element.\relax }}{20}{figure.caption.34}\protected@file@percent }
\newlabel{fig:el-lockmech}{{3.3}{20}{The mechanism of shear locking in a bilinear element under bending (schematic). The exact bending mode curves the edges and has no shear strain; the bilinear interpolation keeps the edges straight, which produces a parasitic shear strain and an artificially stiff element.\relax }{figure.caption.34}{}}
